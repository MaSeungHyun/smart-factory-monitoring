 "kpiSchema": {
  "version": 1,
  "sampleHz": 1,
  "encoding": "chunk tracks.kpi = rows [t, kpi] (t absolute sim s, one row per second, full object each row); snapshot.kpi = kpi at chunk start. Counts are day totals since sim t=0 (warm-up included).",
  "placeholders": {
   "<stage>": "inbound|depalletize|scan|palletize|rackStore|outbound|ship",
   "<scannerId>": "manifest.equipment id of kind scanner",
   "<deviceId>": "robot, vehicle (AMR / forklift / cycle vehicle) or scanner id",
   "<vehicleId>": "vehicle id (equipment[] rows of the sim's agents)",
   "<robotId>": "robot arm id"
  },
  "stages": [
   {
    "id": "inbound",
    "unit": "boxes",
    "count": "boxes arrived (spawned on inbound pallets / infeed)",
    "wip": "arrived boxes not yet depalletized",
    "progressOf": "inbound boxes (always 100 once any arrived)"
   },
   {
    "id": "depalletize",
    "unit": "boxes",
    "count": "boxes taken off inbound pallets onto the line",
    "wip": "depalletized boxes not yet scanned (no scanners: not yet palletized/passed)",
    "progressOf": "inbound boxes"
   },
   {
    "id": "scan",
    "unit": "boxes",
    "count": "boxes with a scan result (first scan per box)",
    "wip": "scanned boxes not yet palletized or passed (0 without scanners)",
    "progressOf": "inbound boxes"
   },
   {
    "id": "palletize",
    "unit": "boxes",
    "count": "boxes placed on output pallets by robots",
    "wip": "boxes on pallets still loading at stations",
    "progressOf": "inbound boxes"
   },
   {
    "id": "rackStore",
    "unit": "pallets",
    "count": "full pallets stored into racks",
    "wip": "full pallets not yet stored (waiting / being carried)",
    "progressOf": "full pallets"
   },
   {
    "id": "outbound",
    "unit": "pallets",
    "count": "outbound (shipping) orders drawn from stored pallets",
    "wip": "drawn orders not yet shipped",
    "progressOf": "full pallets"
   },
   {
    "id": "ship",
    "unit": "pallets",
    "count": "pallets shipped out through the stage door",
    "wip": "always 0 (sink)",
    "progressOf": "full pallets"
   }
  ],
  "keys": [
   {
    "key": "t",
    "unit": "s",
    "type": "number",
    "meaning": "sim time of the sample (absolute)"
   },
   {
    "key": "throughput.processed",
    "unit": "boxes",
    "type": "int",
    "meaning": "processed today = boxes palletized (stages.palletize.count)"
   },
   {
    "key": "throughput.perHour",
    "unit": "boxes/h",
    "type": "number",
    "meaning": "processed in the last 3600 s (scaled up while t < 3600)"
   },
   {
    "key": "throughput.perMinute",
    "unit": "boxes/min",
    "type": "number",
    "meaning": "processed in the last 60 s"
   },
   {
    "key": "throughput.avgPerHour",
    "unit": "boxes/h",
    "type": "number",
    "meaning": "processed / day elapsed"
   },
   {
    "key": "stages.<stage>.count",
    "unit": "boxes|pallets (KPI_STAGES unit)",
    "type": "int",
    "meaning": "day total through the stage"
   },
   {
    "key": "stages.<stage>.wip",
    "unit": "boxes|pallets (KPI_STAGES unit)",
    "type": "int",
    "meaning": "units queued at / inside the stage (KPI_STAGES wip)"
   },
   {
    "key": "stages.<stage>.progress",
    "unit": "%",
    "type": "number",
    "meaning": "count / reference (KPI_STAGES progressOf) * 100"
   },
   {
    "key": "wip.boxes",
    "unit": "boxes",
    "type": "int",
    "meaning": "boxes in process = inbound - palletized - passed (not yet on a pallet)"
   },
   {
    "key": "wip.pallets",
    "unit": "pallets",
    "type": "int",
    "meaning": "full pallets not yet stored + open outbound orders"
   },
   {
    "key": "pallets.full",
    "unit": "pallets",
    "type": "int",
    "meaning": "output pallets completed (filled) today"
   },
   {
    "key": "boxes.passed",
    "unit": "boxes",
    "type": "int",
    "meaning": "boxes that ran off the line end unpicked"
   },
   {
    "key": "scan.scanned",
    "unit": "boxes",
    "type": "int",
    "meaning": "boxes scanned (one result per box)"
   },
   {
    "key": "scan.pass",
    "unit": "boxes",
    "type": "int",
    "meaning": "scan result normal"
   },
   {
    "key": "scan.defect",
    "unit": "boxes",
    "type": "int",
    "meaning": "scan result defect"
   },
   {
    "key": "scan.passRate",
    "unit": "%",
    "type": "number|null",
    "meaning": "pass / scanned * 100 (null before the first scan)"
   },
   {
    "key": "scan.defectRate",
    "unit": "%",
    "type": "number|null",
    "meaning": "defect / scanned * 100 (null before the first scan)"
   },
   {
    "key": "scan.scanners",
    "unit": "count",
    "type": "int",
    "meaning": "registered scanners (0 = scan KPIs not available)"
   },
   {
    "key": "scan.byScanner.<scannerId>.scanned",
    "unit": "boxes",
    "type": "int",
    "meaning": "boxes this scanner scanned"
   },
   {
    "key": "scan.byScanner.<scannerId>.pass",
    "unit": "boxes",
    "type": "int",
    "meaning": "normal results of this scanner"
   },
   {
    "key": "scan.byScanner.<scannerId>.defect",
    "unit": "boxes",
    "type": "int",
    "meaning": "defect results of this scanner"
   },
   {
    "key": "scan.byScanner.<scannerId>.passRate",
    "unit": "%",
    "type": "number|null",
    "meaning": "pass / scanned * 100"
   },
   {
    "key": "scan.byScanner.<scannerId>.defectRate",
    "unit": "%",
    "type": "number|null",
    "meaning": "defect / scanned * 100"
   },
   {
    "key": "rack.stored",
    "unit": "slots",
    "type": "int",
    "meaning": "rack slots holding a pallet"
   },
   {
    "key": "rack.reserved",
    "unit": "slots",
    "type": "int",
    "meaning": "rack slots booked by a delivery in progress"
   },
   {
    "key": "rack.slots",
    "unit": "slots",
    "type": "int",
    "meaning": "rack slots total"
   },
   {
    "key": "rack.occupancy",
    "unit": "%",
    "type": "number",
    "meaning": "stored / slots * 100"
   },
   {
    "key": "vehicles.total",
    "unit": "count",
    "type": "int",
    "meaning": "vehicles"
   },
   {
    "key": "vehicles.busy",
    "unit": "count",
    "type": "int",
    "meaning": "vehicles busy now (not idle / waiting / charging / disabled)"
   },
   {
    "key": "vehicles.utilization",
    "unit": "%",
    "type": "number",
    "meaning": "fleet mean of vehicles.byId.<vehicleId>.utilization"
   },
   {
    "key": "vehicles.byId.<vehicleId>.utilization",
    "unit": "%",
    "type": "number",
    "meaning": "busy seconds / day elapsed * 100"
   },
   {
    "key": "vehicles.byId.<vehicleId>.state",
    "unit": "enum",
    "type": "string",
    "meaning": "sim state (idle|waiting|charging|disabled|pickup|dispatch|loading|...)"
   },
   {
    "key": "devices.<deviceId>.kind",
    "unit": "enum",
    "type": "string",
    "meaning": "robot|vehicle|scanner"
   },
   {
    "key": "devices.<deviceId>.state",
    "unit": "enum",
    "type": "string",
    "meaning": "typed operation state (robots/vehicles: equipment operation; scanners: scanning (scan within 2 s) | idle)"
   },
   {
    "key": "devices.<deviceId>.utilization",
    "unit": "%",
    "type": "number|null",
    "meaning": "robots: busy s / elapsed; vehicles: as vehicles.byId; scanners: null"
   },
   {
    "key": "robots.<robotId>.cycles",
    "unit": "count",
    "type": "int",
    "meaning": "completed robot cycles (boxes moved)"
   },
   {
    "key": "robots.<robotId>.cycleTimeLast",
    "unit": "s",
    "type": "number|null",
    "meaning": "time between the last two completed cycles"
   },
   {
    "key": "robots.<robotId>.cycleTimeAvg",
    "unit": "s",
    "type": "number|null",
    "meaning": "mean of the last 10 cycle intervals"
   },
   {
    "key": "robots.<robotId>.busyPerCycle",
    "unit": "s",
    "type": "number|null",
    "meaning": "busy seconds / cycles (day)"
   },
   {
    "key": "robots.<robotId>.utilization",
    "unit": "%",
    "type": "number",
    "meaning": "busy seconds / day elapsed * 100"
   }
  ]
 },
